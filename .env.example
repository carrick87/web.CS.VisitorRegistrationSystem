# PostgreSQL connection string (required)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Session encryption secret (required in production, min 32 characters)
SESSION_SECRET=

# Secret for POST /api/admin/seed. Required in every environment, including
# Vercel preview, because preview deployments use the production database.
SETUP_SECRET=

# Public origin encoded in printed visitor-tag QR codes.
# Physical labels are permanent, so this must be the production site even when
# labels are printed from a preview deployment. When unset, QR codes fall back
# to the current browser origin (fine for local development).
# Production value: https://web-cs-visitor-registration.vercel.app
NEXT_PUBLIC_SITE_URL=
